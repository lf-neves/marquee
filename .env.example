# TMDB API Read Access Token (v4 auth), from https://www.themoviedb.org/settings/api
TMDB_READ_TOKEN=

# Serve recorded TMDB fixtures instead of calling the API. Tests and CI set this; leave empty for real data.
TMDB_FIXTURES=

# Postgres for the watchlist. Matches docker-compose.yml. Leave empty to run without a watchlist.
DATABASE_URL=postgresql://marquee:marquee@localhost:54339/marquee

# Claude API key for Ask Marquee. Leave empty and the chat explains it is switched off.
ANTHROPIC_API_KEY=

# Canonical origin for metadata and Open Graph images. Vercel provides its own URL when this is empty.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
