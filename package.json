{
  "name": "marquee",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "turbo run build",
    "start": "pnpm -C apps/web start",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm -C apps/web test:e2e",
    "db:up": "docker compose up -d --wait db",
    "db:generate": "pnpm -C packages/db db:generate",
    "db:migrate": "pnpm -C packages/db db:migrate"
  },
  "devDependencies": {
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "turbo": "2.11.13",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@11.1.1"
}
